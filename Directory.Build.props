<Project>
  <!-- 本机开发 quirk 模式：仅当 BUILD_ID 环境变量存在时激活（build.bat 与 agent 构建都会设置）。
       作用：把 obj/bin 重定向到 %LOCALAPPDATA% 唯一子目录，绕过本机 safe-delete 包装
       对 MarkupCompilePass1 CleanupCacheFiles 的拦截（access denied）。
       公开构建 / CI（不设 BUILD_ID）走仓库内标准 obj/bin + 标准 NuGet 审计。 -->
  <PropertyGroup Condition="'$(BUILD_ID)' != ''">
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\TaskbarMusic\obj\$(BUILD_ID)\</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\</IntermediateOutputPath>
    <BaseOutputPath>$(LOCALAPPDATA)\TaskbarMusic\bin\$(BUILD_ID)\</BaseOutputPath>
    <OutputPath>$(BaseOutputPath)$(Configuration)\</OutputPath>

    <!-- 禁用 VBCSCompiler / MSBuild 长驻 server -->
    <UseSharedCompilation>false</UseSharedCompilation>

    <!-- 跳过 NuGet 漏洞审计：vuln_index.dat 也被 safe-delete 拦截写入 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
</Project>
