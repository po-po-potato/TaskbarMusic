<Window x:Class="TaskbarMusic.TaskbarShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarMusic"
        WindowStyle="None"
        ResizeMode="NoResize"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Background="Transparent"
        ShowInTaskbar="False"
        AllowsTransparency="True">

    <Window.Resources>
        <!-- 隐形拖拽边手柄（左/右两侧用于调整宽度） -->
        <Style x:Key="EdgeThumb" TargetType="Thumb">
            <Setter Property="Width" Value="6" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- 根容器：壳默认背景（深色渐变）；模块在自己的 View 上叠背景（如封面取色）。
         Background=#01FFFFFF（alpha=1/255，视觉不可见）：条是分层窗口，alpha=0 像素
         会被 Win32 hit-test 穿透（WindowFromPoint 跳过本窗口直达任务栏）——透明底
         模块（网速/倒数日）的空白区域曾因此收不到滚轮事件（2026-09-21 实锤：
         穿透到 SysListView32）；垫 1/255 alpha 后整条不穿透，透明叠任务栏的视觉不变 -->
    <Grid x:Name="RootBorder" Background="#01FFFFFF">
        <!-- 右键菜单改用 WinForms ContextMenuStrip（与托盘共用）——WPF ContextMenu
             关闭后干扰同进程窗口渲染，导致从右键条开的设置窗 resize 卡；WinForms
             菜单独立于 WPF 渲染/事件体系，托盘走它一直不卡。见 TaskbarShell.BuildContextMenu。 -->

        <!-- 模块区域：E6 槽位容器——Grid 列由 ModuleHost 按槽位状态管理
             （展开槽位 = * 等分，折叠槽位 = Auto 图标位）；单模块启用时
             唯一 * 列占满整条，与 V1 行为一致 -->
        <Grid x:Name="ModulePanel" />

        <!-- 左右隐形宽度调节手柄（最上层，位于模块之上） -->
        <Thumb x:Name="LeftThumb" Style="{StaticResource EdgeThumb}"
               HorizontalAlignment="Left" VerticalAlignment="Stretch"
               DragDelta="LeftThumb_DragDelta" DragCompleted="EdgeThumb_DragCompleted" />
        <Thumb x:Name="RightThumb" Style="{StaticResource EdgeThumb}"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               DragDelta="RightThumb_DragDelta" DragCompleted="EdgeThumb_DragCompleted" />
    </Grid>
</Window>
