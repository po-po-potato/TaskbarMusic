<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms NotifyIcon（框架自带，零第三方依赖）；
         移除其隐式全局 using，避免 UserControl/Color/Application 等 WPF 类型二义性，
         WinForms 类型仅在 TrayIcon.cs 内用完整限定名 -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon></ApplicationIcon>
    <AssemblyName>TaskbarMusic</AssemblyName>
    <RootNamespace>TaskbarMusic</RootNamespace>
    <!-- 开源元数据：设置窗"关于"页读 AssemblyVersion/InformationalVersion 显示版本号 -->
    <Version>1.0.0</Version>
    <Authors>po-po-potato</Authors>
    <Product>TaskbarMusic</Product>
    <Description>Music controller and live lyrics embedded directly into the Windows taskbar</Description>
    <RepositoryUrl>https://github.com/po-po-potato/TaskbarMusic</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <!-- WPF UI（WPF Gallery 官方组件库）：仅设置窗局部应用（窗级合并资源字典，
         见 ThemeService），不进 App.xaml 全局——任务栏条是直角不透明，
         全局合并 ControlsDictionary 会立即替换条上 Button 等隐式样式 -->
    <PackageReference Include="WPF-UI" Version="4.2.1" />
  </ItemGroup>

  <!-- 排除旧的 obj/obj_mvvm 目录：它们里面有 .g.cs 和 .baml 文件，会被 WPF 编译器当源文件编译导致重复定义 -->
  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj_mvvm\**\*.cs" />
    <Page Remove="obj\**\*.xaml" />
    <Page Remove="obj_mvvm\**\*.xaml" />
    <None Remove="obj\**" />
    <None Remove="obj_mvvm\**" />
  </ItemGroup>

</Project>
