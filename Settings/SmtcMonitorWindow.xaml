<ui:FluentWindow x:Class="TaskbarMusic.SmtcMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SMTC 监视器 — TaskbarMusic"
        Width="1080" Height="760"
        MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        ShowInTaskbar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="13">

    <!-- SMTC 监视器（诊断工具）：实时展示系统媒体会话原始值 + 全量事件/决策日志。
         与 SettingsWindow 同款 FluentWindow 骨架（ExtendsContentIntoTitleBar 必须为 True，
         否则 FluentWindow 应用 backdrop 时抛异常）；主题/材质经 ThemeService 单点收敛。
         上半：系统全部 SMTC 会话卡片（原始值，未经 MediaService 防脏守卫）。
         下半：实时日志流（[EVT]/[SESSION]/[PUSH]/[POLL]/[HBEAT]/[MEDIA]/[LYRIC] 全量）。-->

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="RootTitleBar" Title="SMTC 监视器" />

        <Grid Grid.Row="1" Margin="16,4,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1.8*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 会话区头 ===== -->
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <TextBlock Text="系统会话（SMTC 原始值）" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="SessionsStatus" Text="连接中..."
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- ===== 会话列表 ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ItemsControl x:Name="SessionsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        CornerRadius="6" Padding="10,7" Margin="0,0,0,6">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="复制 AUMID"
                                                    Click="OnCopyAumidClick" Tag="{Binding Aumid}"
                                                    Padding="10,3" FontSize="12" Margin="8,0,0,0"
                                                    VerticalAlignment="Center" />                                            <TextBlock Text="{Binding Aumid}"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </DockPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <Border Background="{DynamicResource SystemFillColorSuccessBrush}"
                                                    CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="当前会话" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SystemFillColorCautionBrush}"
                                                    CornerRadius="3" Padding="6,1" Margin="0,0,6,0"
                                                    Visibility="{Binding IsBrowser, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="浏览器" FontSize="11" />
                                            </Border>
                                            <Border Background="{DynamicResource SystemFillColorNeutralBrush}"
                                                    CornerRadius="3" Padding="6,1"
                                                    Visibility="{Binding IsVideoLike, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="视频 · 不搜词" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding DisplayLine}" Margin="0,5,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusLine}" Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="SessionsEmpty" Text="无媒体会话（SMTC 已连接，系统当前没有注册任何媒体会话）"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,4,0,0" Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 日志区头 ===== -->
            <DockPanel Grid.Row="2" Margin="0,2,0,6">
                <TextBlock Text="事件日志（实时 SMTC 事件 + 内部决策）" FontWeight="SemiBold" FontSize="14"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <CheckBox x:Name="AutoScrollBox" Content="自动滚动" IsChecked="True"
                              VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="PauseButton" Content="暂停" Click="OnPauseClick"
                            Padding="12,3" Margin="0,0,6,0" />
                    <Button Content="清空" Click="OnClearClick" Padding="12,3" />
                </StackPanel>
            </DockPanel>

            <GridSplitter Grid.Row="3" Height="8" HorizontalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Auto"
                          Background="Transparent" Cursor="SizeNS" />

            <!-- ===== 日志流 ===== -->
            <Border Grid.Row="4" Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="6" Padding="8">
                <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="LogList" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
