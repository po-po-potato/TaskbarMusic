<UserControl x:Class="TaskbarMusic.StocksSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 财经设置分区（A4）：自选股管理（搜索添加 + 删除；ticker 轮播顺序 = 列表顺序）。
         搜索：腾讯 smartbox（名称/拼音/代码模糊匹配，覆盖 A股/港股）；
         输入本身是合法代码格式（sh600519 等）时回车直接添加。 -->

    <StackPanel>
        <TextBlock Text="财经" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="自选股（条上单股轮播，顺序 = 列表顺序）" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel x:Name="ItemListPanel" />
                <TextBlock x:Name="EmptyHint" Text="暂无自选股，用下方搜索添加"
                           FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="添加（支持名称 / 拼音 / 代码搜索）" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="CodeBox" Width="260" VerticalAlignment="Center"
                                PlaceholderText="如 贵州茅台 / gzmt / hk00700" KeyDown="CodeBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Width="70" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="SearchButton_Click" />
                </Grid>
                <ListBox x:Name="ResultList" Margin="0,10,0,0" MaxHeight="180" Visibility="Collapsed"
                         SelectionChanged="ResultList_SelectionChanged" />
                <TextBlock x:Name="StatusText" Text="输入合法代码（sh600519 / sz300750 / hk00700）回车可直加"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
