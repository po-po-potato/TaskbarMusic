<UserControl x:Class="TaskbarMusic.MusicSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskbarMusic">

    <UserControl.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBool" />
        <local:LenientDoubleConverter x:Key="LenientDouble" />
        <!-- 样式（GroupHeader/SettingRow/RowHint/NumberBox）定义在 SettingsWindow.Resources，
             独立 UserControl 编译期看不到，必须用 DynamicResource 运行时解析 -->
    </UserControl.Resources>

    <StackPanel>
        <!-- ===== 外观 ===== -->
        <TextBlock Style="{DynamicResource GroupHeader}" Text="外观" Margin="0,0,0,4" />

        <Border Style="{DynamicResource SettingRow}">
            <StackPanel>
                <TextBlock Text="背景跟随封面取色" />
                <TextBlock Style="{DynamicResource RowHint}" Text="从当前歌曲封面提取主色作为条背景" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource SettingRow}">
            <CheckBox Content="显示当前歌词" IsChecked="{Binding ShowLyric}" />
        </Border>

        <!-- ===== 歌词模式 ===== -->
        <StackPanel IsEnabled="{Binding ShowLyric}">
            <TextBlock Style="{DynamicResource GroupHeader}" Text="歌词模式" />

            <StackPanel Margin="2,4,0,0">
                <RadioButton GroupName="LyricMode" Content="A　歌名 + 歌词（默认）"
                             IsChecked="{Binding LyricMode, Converter={StaticResource EnumToBool}, ConverterParameter=ReplaceArtist, Mode=TwoWay}" />
                <RadioButton GroupName="LyricMode" Content="B　歌词在上，歌名在下"
                             IsChecked="{Binding LyricMode, Converter={StaticResource EnumToBool}, ConverterParameter=SwapTitleArtist, Mode=TwoWay}" />
                <RadioButton GroupName="LyricMode" Content="C　只显示歌词（大字）"
                             IsChecked="{Binding LyricMode, Converter={StaticResource EnumToBool}, ConverterParameter=LyricOnly, Mode=TwoWay}" />
                <RadioButton GroupName="LyricMode" Content="D　歌词原文 + 翻译（双行）"
                             IsChecked="{Binding LyricMode, Converter={StaticResource EnumToBool}, ConverterParameter=Translate, Mode=TwoWay}" />
                <RadioButton GroupName="LyricMode" Content="E　当前句 + 下一句（垂直跟随）"
                             IsChecked="{Binding LyricMode, Converter={StaticResource EnumToBool}, ConverterParameter=Follow, Mode=TwoWay}" />
            </StackPanel>

            <Border Style="{DynamicResource SettingRow}" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="歌词偏移（秒）" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBox Grid.Column="1" Style="{DynamicResource NumberBox}"
                             Text="{Binding LyricOffsetSec, Converter={StaticResource LenientDouble}, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="正值延后、负值提前（±10 内）" />
                    <TextBlock Grid.Column="2" Style="{DynamicResource RowHint}"
                               Text="校正歌词整体提前/滞后" Margin="12,0,0,0" />
                </Grid>
            </Border>

            <Border Style="{DynamicResource SettingRow}">
                <WrapPanel>
                    <TextBlock Text="换句过渡" VerticalAlignment="Center" Margin="0,0,12,6" />
                    <RadioButton GroupName="LineTransition" Content="硬切"
                                 IsChecked="{Binding LineTransition, Converter={StaticResource EnumToBool}, ConverterParameter=None, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="LineTransition" Content="淡入"
                                 IsChecked="{Binding LineTransition, Converter={StaticResource EnumToBool}, ConverterParameter=Fade, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="LineTransition" Content="上滑"
                                 IsChecked="{Binding LineTransition, Converter={StaticResource EnumToBool}, ConverterParameter=Slide, Mode=TwoWay}" Margin="0,0,0,6" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- ===== 播放 ===== -->
        <TextBlock Style="{DynamicResource GroupHeader}" Text="播放" />

        <Border Style="{DynamicResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="暂停淡出补偿（秒）" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" Style="{DynamicResource NumberBox}"
                         Text="{Binding PauseFadeOutSec, Converter={StaticResource LenientDouble}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" Style="{DynamicResource RowHint}"
                           Text="每次暂停多偏一点就调它" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- ===== 字体 ===== -->
        <TextBlock Style="{DynamicResource GroupHeader}" Text="字体" />

        <Border Style="{DynamicResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="字体" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox Grid.Column="1" x:Name="CbFontFamily"
                          IsEditable="True"
                          Text="{Binding FontFamily, UpdateSourceTrigger=PropertyChanged}"
                          ItemsSource="{Binding SystemFonts}" />
            </Grid>
        </Border>

        <Border Style="{DynamicResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="歌名字号" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" Style="{DynamicResource NumberBox}"
                         Text="{Binding TitleFontSize, Converter={StaticResource LenientDouble}, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Column="2" />
                <TextBlock Grid.Column="3" Text="艺术家字号" VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBox Grid.Column="4" Style="{DynamicResource NumberBox}"
                         Text="{Binding ArtistFontSize, Converter={StaticResource LenientDouble}, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <!-- 应用（字号输入框失焦兜底写回，归属音乐分区） -->
        <Border Style="{DynamicResource SettingRow}" BorderThickness="0">
            <Button Content="应用" Command="{Binding ApplyCommand}"
                    HorizontalAlignment="Right" Width="90" />
        </Border>
    </StackPanel>
</UserControl>
