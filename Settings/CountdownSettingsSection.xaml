<UserControl x:Class="TaskbarMusic.CountdownSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 倒数日设置分区（A7）：列表管理（名称 + 日期 + 每年重复，增删）。
         code-behind 直改 AppConfig（简单 CRUD，无 VM 绑定复杂度）；
         改动即时生效（CountdownModule.NotifyItemsChanged 重算）+ 即时落盘。 -->

    <StackPanel>
        <TextBlock Text="倒数日" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="列表（条上显示最近一项；≤7 天标蓝，当天高亮）" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <StackPanel x:Name="ItemListPanel" />
                <TextBlock x:Name="EmptyHint" Text="暂无项目，用下方添加"
                           FontSize="12" Visibility="Collapsed"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="添加" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="NameBox" Grid.Column="0" Width="160" VerticalAlignment="Center"
                               PlaceholderText="名称，如 老妈生日" />
                    <ui:TextBox x:Name="DateBox" Grid.Column="1" Width="110" Margin="8,0,0,0" VerticalAlignment="Center"
                               PlaceholderText="2026-10-01" />
                    <CheckBox x:Name="AnnualCheck" Grid.Column="2" Content="每年" Margin="10,0,0,0"
                              VerticalAlignment="Center" />
                    <Button x:Name="AddButton" Grid.Column="3" Content="添加" Width="70" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="AddButton_Click" />
                </Grid>
                <TextBlock Text="日期格式 yyyy-MM-dd；勾选「每年」的项到期后自动滚到下一年（生日/纪念日），普通项过期自动隐藏"
                           FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
