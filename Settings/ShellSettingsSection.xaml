<UserControl x:Class="TaskbarMusic.ShellSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskbarMusic">

    <UserControl.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <!-- 样式（GroupHeader/SettingRow/RowHint）定义在 SettingsWindow.Resources，
         独立 UserControl 编译期看不到，必须用 DynamicResource 运行时解析 -->
    <StackPanel>
        <TextBlock Style="{DynamicResource GroupHeader}" Text="布局" Margin="0,0,0,4" />

        <Border Style="{DynamicResource SettingRow}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="条宽度" VerticalAlignment="Center" />
                    <TextBlock Style="{DynamicResource RowHint}" Text="拖动条右缘调整；重置恢复默认" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding WindowWidth, StringFormat={}{0:0} px}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <Border Style="{DynamicResource SettingRow}" BorderThickness="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="重置位置" Command="{Binding ResetPositionCommand}" Margin="0,0,8,0" />
                <Button Content="重置宽度" Command="{Binding ResetWidthCommand}" />
            </StackPanel>
        </Border>

        <!-- 设置窗背景材质（提议做成设置项）：三选一，切换即存配置
             并自动重开设置窗使新材质生效。-->
        <TextBlock Style="{DynamicResource GroupHeader}" Text="设置窗背景材质" />

        <Border Style="{DynamicResource SettingRow}">
            <StackPanel>
                <TextBlock Text="材质选择" />
                <TextBlock Style="{DynamicResource RowHint}"
                           Text="Mica/Acrylic 需 Win11 22H2+；切换后设置窗自动重开生效" />
            </StackPanel>
        </Border>
        <Border Style="{DynamicResource SettingRow}">
            <WrapPanel Margin="0,6,0,0">
                <RadioButton GroupName="WindowBackdrop" Content="纯色"
                             IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=None, Mode=TwoWay}" Margin="0,0,12,6" />
                <RadioButton GroupName="WindowBackdrop" Content="Mica"
                             IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Mica, Mode=TwoWay}" Margin="0,0,12,6" />
                <RadioButton GroupName="WindowBackdrop" Content="Acrylic"
                             IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Acrylic, Mode=TwoWay}" Margin="0,0,0,6" />
            </WrapPanel>
        </Border>
        <Border Style="{DynamicResource SettingRow}" BorderThickness="0">
            <TextBlock Style="{DynamicResource RowHint}"
                       Text="纯色最流畅；Mica 壁纸着色（本机仅激活态可见）；Acrylic 实时模糊效果最明显但拖动窗口有开销" />
        </Border>
    </StackPanel>
</UserControl>
