<UserControl x:Class="TaskbarMusic.ShellSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:TaskbarMusic">

    <UserControl.Resources>
        <local:EnumToBoolConverter x:Key="EnumToBool" />
    </UserControl.Resources>

    <!-- 常规分区（重归类版）：字体（全局项）+ 个性化（材质/重置）。
         布局组已删——条宽度是只读显示无交互价值，重置降级为普通行 -->

    <StackPanel>
        <!-- ===== 字体：全局项，设置窗整体跟随渲染 ===== -->
        <TextBlock Text="字体" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="界面字体" VerticalAlignment="Center" Margin="0,0,12,0" />
                <!-- 纯下拉不可输入：SelectedItem 按值匹配列表项，非法值由 VM 构造时回退 -->
                <ComboBox Grid.Column="1"
                          SelectedItem="{Binding FontFamily}"
                          ItemsSource="{Binding SystemFonts}"
                          ToolTip="设置窗与条上文字的字体，实时生效" />
            </Grid>
        </ui:Card>

        <!-- ===== 模块（E6 单屏轮播）：条上滚轮切换显示对象，一次只显示一个 ===== -->
        <TextBlock Text="模块" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ModuleRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 排序：MDL2 细线 chevron，与条上按钮图标风格一致 -->
                                <Button Grid.Column="0" Command="{Binding MoveUpCommand}" ToolTip="轮播顺序前移"
                                        Width="26" Height="24" Margin="0,0,2,0" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE70E;" />
                                <Button Grid.Column="1" Command="{Binding MoveDownCommand}" ToolTip="轮播顺序后移"
                                        Width="26" Height="24" Margin="0,0,10,0" Padding="0"
                                        FontFamily="Segoe MDL2 Assets" FontSize="12" Content="&#xE70D;" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                                <CheckBox Grid.Column="3" Content="启用" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="条是一块固定宽度的小显示屏：同时只显示一个模块，鼠标在条上滚动切换（上=前一个，下=后一个）；↑↓ 调整轮播顺序；取消勾选停用模块（服务停止）"
                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <!-- ===== 显示器（A7 多显示器）：勾选挂条的屏幕，全不勾回落主屏 ===== -->
        <TextBlock Text="显示器" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <StackPanel x:Name="MonitorListPanel" />
                <TextBlock Text="勾选要在该屏任务栏挂条的显示器（可只挂副屏）；全部取消勾选时回落主屏保底；模块状态（切歌/倒计时）跨条自动同步；各条位置独立拖动互不影响"
                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <!-- ===== 个性化 ===== -->
        <TextBlock Text="个性化" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="颜色" />
                <WrapPanel Margin="0,8,0,0">
                    <RadioButton GroupName="AppTheme" Content="深色"
                                 IsChecked="{Binding AppTheme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="AppTheme" Content="浅色"
                                 IsChecked="{Binding AppTheme, Converter={StaticResource EnumToBool}, ConverterParameter=Light, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="AppTheme" Content="跟随系统"
                                 IsChecked="{Binding AppTheme, Converter={StaticResource EnumToBool}, ConverterParameter=System, Mode=TwoWay}" Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="设置窗背景材质" />
                <TextBlock Text="Mica/Acrylic 需 Win11 22H2+；切换后设置窗自动重开生效"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BackdropEnvHint" Text="当前环境不支持材质（系统透明效果已关闭或远程桌面会话），已降级纯色背景" Visibility="Collapsed"
                           FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <WrapPanel Margin="0,8,0,0">
                    <RadioButton GroupName="WindowBackdrop" Content="纯色"
                                 IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=None, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="WindowBackdrop" Content="Mica"
                                 IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Mica, Mode=TwoWay}" Margin="0,0,12,6" />
                    <RadioButton GroupName="WindowBackdrop" Content="Acrylic"
                                 IsChecked="{Binding WindowBackdrop, Converter={StaticResource EnumToBool}, ConverterParameter=Acrylic, Mode=TwoWay}" Margin="0,0,0,6" />
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <TextBlock Text="纯色最流畅；Mica 壁纸着色（本机仅激活态可见）；Acrylic 实时模糊效果最明显但拖动窗口有开销"
                   FontSize="12" TextWrapping="Wrap" Margin="4,0,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <!-- 重置操作（原布局组降级）：条拖坏了救回来用 -->
        <ui:Card Margin="0,8,0,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="重置条位置" Command="{Binding ResetPositionCommand}" Margin="0,0,8,0" />
                <Button Content="重置条宽度" Command="{Binding ResetWidthCommand}" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
