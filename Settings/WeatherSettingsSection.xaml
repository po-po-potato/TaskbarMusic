<UserControl x:Class="TaskbarMusic.WeatherSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 天气设置分区（A3）：城市搜索（Open-Meteo geocoding，免费无 key）。
         搜索结果列表点选 → 保存城市名 + 经纬度 → 模块立即刷新。
         未配置时条内显示占位；IP 定位不做（设计稿：默认手动）。 -->

    <StackPanel>
        <TextBlock Text="天气" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock x:Name="CurrentCityText" Text="当前：未配置" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox x:Name="CityBox" Width="240" VerticalAlignment="Center"
                                PlaceholderText="城市名，如 深圳 / Tokyo" KeyDown="CityBox_KeyDown" />
                    <Button x:Name="SearchButton" Grid.Column="1" Content="搜索" Width="70" Margin="10,0,0,0"
                            VerticalAlignment="Center" Click="SearchButton_Click" />
                </Grid>
                <ListBox x:Name="ResultList" Margin="0,10,0,0" MaxHeight="150" Visibility="Collapsed"
                         SelectionChanged="ResultList_SelectionChanged" />
                <TextBlock x:Name="StatusText" Text="" FontSize="12" Margin="0,8,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="数据说明" Margin="0,0,0,8"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="数据源 Open-Meteo（免费无 key）· 30 分钟自动刷新 · 断网时显示缓存数据与最后更新时间 · 当前天气 + 今明后三天预报"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</UserControl>
