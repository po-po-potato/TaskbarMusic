<UserControl x:Class="TaskbarMusic.PomodoroSettingsSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- 番茄钟设置分区（F2）：时长两卡 + 应用按钮（模式对齐音乐分区）。
         改时长只影响下一段，运行中的当前段不打断。 -->
    <StackPanel>
        <TextBlock Text="番茄钟" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,16"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="专注时长（分钟）" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:NumberBox Grid.Column="1" Width="110" Minimum="1" Maximum="180"
                              Value="{Binding WorkMin, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="默认 25"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="休息时长（分钟）" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:NumberBox Grid.Column="1" Width="110" Minimum="1" Maximum="60"
                              Value="{Binding BreakMin, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Text="专注完成自动进入；默认 5"
                           FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </ui:Card>

        <ui:Card Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="计时规则" Margin="0,0,0,6"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                <TextBlock Text="条上：单击 = 开始/暂停/恢复；双击 = 重置当前段；右键 = 阶段操作与快速倒计时（1/5/10/25/45 分钟）。"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="改时长只影响下一段，进行中的当前段不变；今日完成数跨重启累计、隔天自动清零。"
                           FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </ui:Card>

        <Button Content="应用" Command="{Binding ApplyCommand}"
                HorizontalAlignment="Right" Width="90" Margin="0,4,4,0" />
    </StackPanel>
</UserControl>
