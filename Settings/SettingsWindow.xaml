<ui:FluentWindow x:Class="TaskbarMusic.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:TaskbarMusic"
        Title="TaskbarMusic 设置"
        Width="1000" Height="560"
        MinWidth="600" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ExtendsContentIntoTitleBar="True"
        ShowInTaskbar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        FontSize="14">

    <!-- ExtendsContentIntoTitleBar 必须为 True：FluentWindow 应用 backdrop 的
         硬性前提（OnSourceInitialized→OnBackdropTypeChanged 检查，
         false 直接抛 InvalidOperationException——2026-08-26 打开设置窗闪退实锤）。
         Foreground 喂 Fluent 主题资源：窗口前景继承给所有分区 TextBlock——
         不设的话继承 WPF 默认黑，深色主题下文字看不清。
         默认宽高 1000x560（用户拖动后的实际宽高会存配置，构造时覆盖）。
         常规窗口（非 Topmost，2026-08-26 撤浮层残留）：被遮挡时经任务栏/Alt+Tab 唤回。 -->

    <!-- 设置窗（WPF Gallery 组件版）：FluentWindow + TitleBar + NavigationView，
         组件来自 Wpf.Ui（WPF Gallery 官方库）。
         主题/材质经 ThemeService 单点收敛；字典窗级合并不进 App.xaml 全局
         （任务栏条不吃 Fluent，见 ThemeService 注释）。
         字典在这里合并后，窗内原生控件（Button/ComboBox/RadioButton 等）
         隐式样式自动 Fluent 化，分区不再需要窗级样式 DynamicResource hack；
         resize 卡顿的 SystemColors DynamicResource 补丁一并消掉。-->

    <ui:FluentWindow.Resources>
        <!-- ThemesDictionary/ControlsDictionary 已在 App.Resources 合并（见 App.xaml）；
             不在窗级重复合并——UserControl 内隐式样式查找走 Application 级更可靠
             （WPF 隐式样式对合并字典的可见性有 quirk，App 级合并是 Wpf.Ui 官方路径） -->
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" x:Name="RootTitleBar" Title="TaskbarMusic 设置"
                     ShowMaximize="False" ShowMinimize="False" />
        <!-- TitleBar 前景色由代码喂 ApplicationTheme（见 ThemeService 注释），
             否则标题/关闭按钮是默认淡色看不见 -->

        <!-- 左导航（Win11 设置式）：分区项代码生成（壳分区 + 模块分区）。
             NavigationView 非 ContentControl——内容区由代码 SetContent 装载
             （分区实例常驻、切换只换 Content 的宿主装配语义与旧版一致） -->
        <ui:NavigationView Grid.Row="1" x:Name="NavView"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False">
            <ui:NavigationView.MenuItems />
        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
