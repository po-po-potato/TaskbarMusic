<UserControl x:Class="TaskbarMusic.StocksModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A4 财经模块（设计稿定稿：单股静态轮播，不滚动）。
         条内形态：名称 13 + 当日分时 sparkline 90×26（线条/填充随涨跌着色）+
         现价 13 等宽 + 涨跌幅 13 SemiBold（红涨 #FF6B6B 绿跌 #3DDC84），
         组内 gap 12，透明底靠左聚拢。代码等确认信息归 hover 浮层（条内不常驻）。
         双节奏解耦：行情 5s 轮询（全部自选股，准实时）· 展示 8s 轮换（120ms 淡入，
         与 E6 同语言）。hover 暂停轮换 + 自选股浮层。 -->

    <Grid Background="Transparent">
        <StackPanel x:Name="RootPanel" Orientation="Horizontal" HorizontalAlignment="Left"
                    VerticalAlignment="Center" Margin="14,0,0,0">
            <TextBlock x:Name="NameText" Text="--" FontSize="13" Foreground="White"
                       VerticalAlignment="Center" />
            <Canvas x:Name="SparkCanvas" Width="90" Height="26" Margin="12,0,0,0"
                    VerticalAlignment="Center" />
            <TextBlock x:Name="PriceText" Text="--" FontFamily="Consolas" FontSize="13"
                       Foreground="White" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ChangeText" Text="--" FontFamily="Consolas" FontSize="13"
                       FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
