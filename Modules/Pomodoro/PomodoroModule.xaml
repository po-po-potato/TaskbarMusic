<UserControl x:Class="TaskbarMusic.PomodoroModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- F2 番茄钟/倒计时模块（PRD 4.3 F2.1/F2.2/F2.5；2026-09-21 按交互稿定稿改版）。
         布局：满宽内容靠左聚拢——圆点 + 等宽倒计时（Consolas，数字变化不跳宽）+
         阶段文字单行。「今日 N」计数已砍（低频统计归 hover 浮层，条内只留高频状态）。
         交互区 = 内容区 HitArea（单击启停/双击重置/右键菜单）；右侧空白区点击
         冒泡到壳（可拖动条），与音乐模块"非交互区拖拽"语义一致。
         暂停态视觉降级：圆点空心（阶段色描边）+ 倒计时 55% 透明 + "已暂停"文案。
         到点闪烁用 overlay 层（不动画根背景——分层子窗口里背景动画重渲成本高）。 -->
    <Grid x:Name="ModuleRoot" Background="#E6202030">

        <!-- 到点闪烁层：工作完成闪绿 / 休息·倒计时结束闪橙 -->
        <Grid x:Name="FlashOverlay" Background="#3DDC84" Opacity="0" IsHitTestVisible="False" />

        <!-- 交互区（Background=Transparent 才能收 hit-test；靠左聚拢，右空白冒泡给壳） -->
        <StackPanel x:Name="HitArea" Orientation="Horizontal"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0"
                    Background="Transparent"
                    MouseLeftButtonDown="HitArea_MouseLeftButtonDown"
                    MouseRightButtonUp="HitArea_MouseRightButtonUp">
            <Ellipse x:Name="PhaseDot" Width="10" Height="10" Fill="#9E9E9E" />
            <TextBlock x:Name="TimeText" Text="25:00" FontFamily="Consolas"
                       FontSize="20" FontWeight="SemiBold" Foreground="White"
                       Margin="10,0,14,0" />
            <TextBlock x:Name="PhaseText" Text="待命" FontSize="11"
                       Foreground="#CCFFFFFF" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
