<UserControl x:Class="TaskbarMusic.WeatherModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A3 天气模块（设计稿定稿：交互态页 A3 卡）。
         条内形态：高频三元素——图标 18 + 温度 16 SemiBold + 天气描述 13 白 70%，
         透明底靠左聚拢（叠于任务栏底色）。今温区间/城市/湿度风等低频信息归 hover 浮层。
         无点击行为（信息模块）；数据 Open-Meteo（免费无 key），30min 定时刷新，
         断网显示缓存 + 最后更新时间。 -->

    <Grid Background="Transparent">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Margin="14,0,0,0">
            <ContentControl x:Name="IconHost" Width="18" Height="18" VerticalAlignment="Center" />
            <TextBlock x:Name="TempText" Text="--°" FontSize="16" FontWeight="SemiBold"
                       Foreground="White" Margin="8,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="DescText" Text="未配置" FontSize="13"
                       Foreground="#B3FFFFFF" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
