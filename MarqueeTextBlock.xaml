<UserControl x:Class="TaskbarMusic.MarqueeTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="True"
             Focusable="False">
    <!-- 静态句尾对齐方案：超宽时 TextBlock 用 TranslateTransform 左移，让句尾顶住右边缘，
         左侧超出部分靠 ClipToBounds 裁掉（效果 ...句尾]）。不滚动、无动画。
         宽度用 TextBlock.Measure 直接量，不依赖布局事件时序。
         注意：Canvas 自身 DesiredSize 恒为 0，必须给显式 Height 才能撑起行高，
         否则整行塌成 0 → 什么都不显示。Height 在代码里随字号更新，此处给兜底。 -->
    <Canvas x:Name="HostCanvas" ClipToBounds="True" Height="18" MinHeight="1">
        <TextBlock x:Name="MainText" Text=""
                   Canvas.Left="0" Canvas.Top="0"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   FontFamily="{Binding FontFamily, ElementName=Root}"
                   FontSize="{Binding TextFontSize, ElementName=Root}"
                   FontWeight="{Binding TextFontWeight, ElementName=Root}"
                   TextAlignment="Left" TextWrapping="NoWrap"
                   RenderTransformOrigin="0,0.5">
            <!-- TransformGroup：Shift=滚动/上滑平移；LineScale=换句缩放（锚点左中，
                 从行首生长，左对齐文本缩放不跳位；平移不受 RenderTransformOrigin 影响） -->
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="Shift" X="0" Y="0" />
                    <ScaleTransform x:Name="LineScale" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <!-- 推挤过渡的旧句载体：换句瞬间显示上一句，整行推上淡出后隐藏。
             绑定与 MainText 完全一致（同字号/字体/前景，保证宽度对齐）。 -->
        <TextBlock x:Name="GhostText" Text="" Visibility="Collapsed"
                   Canvas.Left="0" Canvas.Top="0"
                   Foreground="{Binding Foreground, ElementName=Root}"
                   FontFamily="{Binding FontFamily, ElementName=Root}"
                   FontSize="{Binding TextFontSize, ElementName=Root}"
                   FontWeight="{Binding TextFontWeight, ElementName=Root}"
                   TextAlignment="Left" TextWrapping="NoWrap"
                   IsHitTestVisible="False">
            <TextBlock.RenderTransform>
                <TranslateTransform x:Name="GhostShift" X="0" Y="0" />
            </TextBlock.RenderTransform>
        </TextBlock>
    </Canvas>
</UserControl>
